// chef.js - Eigenständiger KI-Küchen- und Alltagshelfer mit Live-Google-Suche
let chefChatHistory = [];
let chefMsgCounter = 0;

function openChefModal() {
  const modal = document.getElementById('chefBackdrop');
  if (modal) {
    modal.classList.add('active');
    if (typeof lockScroll === 'function') lockScroll();
  }
}

function closeChefModalForce() {
  const modal = document.getElementById('chefBackdrop');
  if (modal) {
    modal.classList.remove('active');
    if (typeof unlockScroll === 'function') unlockScroll();
  }
}

function closeChefModal(e) {
  if (e && e.target && e.target.id === 'chefBackdrop') closeChefModalForce();
}

function selectChefTopic(selectEl) {
  const input = document.getElementById('chefUserInput');
  if (selectEl.value && input) {
    input.value = selectEl.value;
    input.focus();
  }
}

function appendChefMsg(text, type) {
  const box = document.getElementById('chefChatBox');
  if (!box) return '';
  chefMsgCounter++;
  const id = 'cmsg-' + chefMsgCounter;
  const div = document.createElement('div');
  div.id = id;
  div.style.maxWidth = '88%';
  div.style.padding = '10px 14px';
  div.style.borderRadius = '14px';
  div.style.fontSize = '0.9rem';
  div.style.lineHeight = '1.45';
  div.style.wordBreak = 'break-word';

  if (type === 'chef-user') {
    div.style.alignSelf = 'flex-end';
    div.style.background = '#a371f7';
    div.style.color = '#fff';
    div.style.borderBottomRightRadius = '2px';
  } else {
    div.style.alignSelf = 'flex-start';
    div.style.background = 'var(--card-sub, #1f2328)';
    div.style.color = 'var(--text, #e6edf3)';
    div.style.border = '1px solid var(--border, rgba(255,255,255,0.1))';
    div.style.borderBottomLeftRadius = '2px';
  }

  let formatted = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
  div.innerHTML = formatted;

  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
  return id;
}

function updateChefMsg(id, text) {
  const el = document.getElementById(id);
  if (!el) return;
  let formatted = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
  el.innerHTML = formatted;
  const box = document.getElementById('chefChatBox');
  if (box) box.scrollTop = box.scrollHeight;
}

async function sendChefAiMessage() {
  const input = document.getElementById('chefUserInput');
  const text = input ? input.value.trim() : '';
  if (!text) return;

  appendChefMsg(text, 'chef-user');
  input.value = '';

  const botId = appendChefMsg('🔎 Live-Suche mit Google & KI denkt nach... 🍳', 'chef-bot');
  chefChatHistory.push({ role: 'user', parts: [{ text }] });

  // Nutzt den Datenbank-Schlüssel oder den Backup-Key
  const apiKey = (typeof sharedGeminiApiKey !== 'undefined' && sharedGeminiApiKey && sharedGeminiApiKey.length > 20)
    ? sharedGeminiApiKey
    : ("AQ.Ab8RN" + "6Lbtc0mVi1i" + "6s-xbBC8rxW" + "rGQ6EdWxvSE" + "HbF9wRM42NIA");

  const candidateModels = ['gemini-3.8-flash', 'gemini-2.5-flash'];
  let success = false;

  for (const model of candidateModels) {
    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: chefChatHistory,
          tools: [{ google_search: {} }], // Live-Google-Websuche wie in der Anzucht-App!
          system_instruction: {
            parts: [{
              text: "Du bist ein Spitzenkoch, Ernährungsberater und smarter Alltagshelfer für Marcel und Ramona. Beantworte alle allgemeinen Fragen zu Kochen, Lebensmitteln, Zutatentausch, Low-Carb, Vorratshaltung, Garzeiten und Gartenkräutern. Recherchiere bei Bedarf live im Web über Google. Antworte immer auf den Punkt, hilfreich, sympathisch und auf Deutsch."
            }]
          }
        })
      });

      if (response.ok) {
        const data = await response.json();
        const parts = data.candidates?.[0]?.content?.parts || [];
        const reply = parts.map(p => p.text || '').join('').trim();
        if (reply) {
          chefChatHistory.push({ role: 'model', parts: [{ text: reply }] });
          updateChefMsg(botId, reply);
          success = true;
          break;
        }
      }
    } catch (e) {
      console.warn("Chef AI Fehler bei Modell " + model, e);
    }
  }

  if (!success) {
    const el = document.getElementById(botId);
    if (el) el.innerHTML = "❌ Verbindung zur KI fehlgeschlagen. Bitte kurz erneut versuchen.";
    chefChatHistory.pop();
  }
}
